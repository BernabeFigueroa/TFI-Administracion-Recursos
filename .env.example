HOST=127.0.0.1
PORT=3000
DB_PATH=./data/rtl.sqlite
# Optional: use Supabase PostgreSQL instead of SQLite. Never commit real credentials.
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres"
# DATABASE_CA_FILE=./server/certs/supabase-ca.crt
# Enable only behind HTTPS in a deployed environment.
COOKIE_SECURE=false
# Required for production; exact browser origin, without trailing slash.
# APP_ORIGIN=https://tu-dominio.com
# Render supplies RENDER_EXTERNAL_URL automatically; APP_ORIGIN can be omitted there.
